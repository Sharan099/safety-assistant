# Embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Hugging Face Hub token (higher rate limits; no anonymous Hub warning)
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Qdrant — local path OR remote URL (prefer one)
QDRANT_PATH=./data/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Collection name
QDRANT_COLLECTION=regulations

# Optional: where Docling JSON exports are written
DOCLING_EXPORT_DIR=./data/docling

# Optional: selective LightOnOCR-2 pass on figure/table-adjacent pages only
# (keeps Docling for the bulk of clause text). Off by default.
# VLM_FIGURE_PASS=0
# VLM_FIGURE_MODEL=lightonai/LightOnOCR-2-1B-bbox
# VLM_FIGURE_WORK_DIR=./data/vlm_figure_pass

# --- LLM -------------------------------------------------------------------
# Default mock so casual runs never call a real provider.
LLM_PROVIDER=mock
# Live mode routes through the local Portkey gateway using config/portkey/*.json
# fallback chains (rewrite / answer / judge). No Portkey cloud account needed.
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides for the first target model in rewrite / answer configs
# GROQ_SMALL_MODEL=llama-3.1-8b-instant
# GROQ_LARGE_MODEL=llama-3.3-70b-versatile

# Local Portkey AI Gateway (open-source, https://github.com/portkey-ai/gateway).
# No Portkey cloud account needed for proxy / fallback / load-balance / local cache.
# Standalone:  docker run --rm -p 8787:8787 portkeyai/gateway:latest
# Compose:     docker compose up -d portkey  (api container uses http://portkey:8787/v1)
# Host processes (uvicorn, CLI, eval) should keep localhost:
PORTKEY_GATEWAY_URL=http://localhost:8787/v1
# PORTKEY_CONFIG_DIR=./config/portkey
# Whole-chain HTTP wait (must exceed per-target request_timeout × fallbacks).
# Fix 17/28: default 35s — do not allow 57s multi-fallback hangs.
# PORTKEY_CLIENT_TIMEOUT_S=35
# Nemotron Super defaults to reasoning ON — disable via Portkey override_params
# (chat_template_kwargs.enable_thinking=false). Optional prompt prefix:
# NIM_NO_THINK_PROMPT=1
# NVIDIA_API_KEY=
# Gemini 2.5 Flash defaults to dynamic thinking (often 8–60s). Final-answer /
# rewrite / judge Google targets force thinking.budget_tokens=0 and a ~10s
# per-target request_timeout so slow Google legs fall through on HTTP 408.
# GEMINI_MODEL=gemini-2.5-flash
# Prefer gemini-2.0-flash when available if you want a non-thinking Flash SKU.


# Disk cache + Phase-4 dashboard jsonl feed
LLM_CACHE_DIR=./data/llm_cache
LLM_LOG_PATH=./data/logs/llm_calls.jsonl

# Eval judges (RAGAS / DeepEval) — PINNED single model (not production fallback)
# Default: gemini-2.5-flash via config/portkey/eval_judge_pinned.json
# EVAL_JUDGE_MODEL=gemini-2.5-flash
# EVAL_JUDGE_PROVIDER=google
# RAGAS_JUDGE_MODEL / SECURITY_JUDGE_MODEL also accepted as aliases for the pin.
# Eval-infra retries (separate from production LLMClient retries):
# EVAL_JUDGE_MAX_RETRIES=4
# EVAL_JUDGE_RETRY_BASE_SEC=1.5
# Per-case wall-clock deadline via a persistent *process* worker (not threads).
# Kills hung native work (reranker/embeddings) without AV'ing the parent harness.
# EVAL_CASE_TIMEOUT=1
# EVAL_CASE_TIMEOUT_S=900
# Skip DeepTeam PromptInjection.enhance (use golden text as-is): SECURITY_SKIP_ATTACK_ENHANCE=1
# Skip LLM-judge metrics (substring checks still run): RAGAS_SKIP=1

# Retrieval
RETRIEVAL_TOP_K=5
HYBRID_TOP_K=30
HYBRID_PREFETCH_K=30
# Client-side weighted RRF: raise sparse for exact regulatory-term queries (HPC/RDC/…).
# HYBRID_DENSE_WEIGHT=1.0
# HYBRID_SPARSE_WEIGHT=1.0
# HYBRID_DENSE_WEIGHT_EXACT=1.0
# HYBRID_SPARSE_WEIGHT_EXACT=1.75
# Structured limits for deterministic compliance checks (see ingestion.extract_limits).
# LIMITS_DIR=./data/limits
# EXTRACT_LIMITS_ON_INGEST=0
# MULTI_CRITERION_TOP_K=3
# MULTI_CRITERION_CONTEXT_MAX_CHUNKS=9
# MULTI_CRITERION_CONTEXT_MAX_TOKENS=6000
RETRIEVAL_REWRITE=1
# LLM subquery split is OFF by default (deterministic heuristic split). Set to 1
# only if you want the rewrite model to invent subqueries (can vary run-to-run).
# RETRIEVAL_REWRITE_LLM=0
RETRIEVAL_RERANK=1
RETRIEVAL_SMALL_TO_BIG=1
# Hard context budget sent to the answer LLM (standard single-fact queries).
CONTEXT_MAX_CHUNKS=5
CONTEXT_MAX_TOKENS=3000
# Query intent router (retrieval/router.py): regex fast-path + optional cheap LLM.
# QUERY_ROUTER_LLM=1
# QUERY_INTENT_AUDIT_PATH=./eval/results/query_intent_audit.jsonl
# Design-implication component→concept map (engineer-reviewed domain knowledge).
# DESIGN_COMPONENTS_PATH=./config/design_components.json
# DESIGN_PER_REG_TOP_K=3
# DESIGN_IMPLICATION_RETRIEVE=1
# Homologation checklist: separate retrieval per category.
# CHECKLIST_CATEGORIES_PATH=./config/checklist_categories.json
# CHECKLIST_PER_CATEGORY_TOP_K=4
# CHECKLIST_GEN_RETRIEVE=1
# Scope summary: deterministic section anchors + hard-reg lock.
# SCOPE_SUMMARY_SECTIONS_PATH=./config/scope_summary_sections.json
# SCOPE_SUMMARY_RETRIEVE=1
# Applicability: Scope clause of each indexed regulation + ternary verdicts.
# APPLICABILITY_RETRIEVE=1
# Retest / modification: extension-of-approval clauses + mandatory honesty banner.
# RETEST_MODIFICATION_SECTIONS_PATH=./config/retest_modification_sections.json
# RETEST_SCOPE_RETRIEVE=1
# Optional per-intent budget overrides (Fix 13 caps — defaults on PipelineConfig):
# INTENT_DESIGN_IMPLICATION_MAX_CHUNKS=10
# INTENT_DESIGN_IMPLICATION_MAX_TOKENS=4500
# INTENT_CHECKLIST_GEN_MAX_CHUNKS=14
# INTENT_RETEST_SCOPE_MAX_CHUNKS=10
# INTENT_APPLICABILITY_MAX_CHUNKS=12
# Enumerative path (list all/every/summarize all): broader rerank + higher budget.
ENUM_RERANK_TOP_K=20
ENUM_HYBRID_TOP_K=40
ENUM_CONTEXT_MAX_CHUNKS=20
ENUM_CONTEXT_MAX_TOKENS=8000
# Skip small-to-big when merged parent would exceed this (Annex-scale blowups).
MAX_PARENT_EXPAND_TOKENS=800
SMALL_TO_BIG_SCROLL_LIMIT=16
# Qdrant HNSW: raise ef for stable top-k; exact=1 for full-scan determinism (small corpora).
QDRANT_HNSW_EF=256
# QDRANT_EXACT_SEARCH=1

# Reranker: local CrossEncoder (default) or Cohere
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5
# Optional floors after the fixed top-k window (BGE logits ~0–45 on this corpus):
#   RERANK_MIN_SCORE — absolute score floor
#   RERANK_SCORE_MARGIN — keep scores within margin of the best in-window score
# Tune: python scripts/ab_rerank_min_score.py
# Default: leave both unset. See eval/results/rerank_min_score_ab.json
# RERANK_MIN_SCORE=
# RERANK_SCORE_MARGIN=
# Final answer sampling (rewrite/condense/judge always use temperature=0).
# ANSWER_TEMPERATURE=0
# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PDF_DIR=./data/pdfs

# Observability / cost
PRICES_PATH=./config/prices.json
TRACE_DIR=./data/traces
ANSWER_CACHE=0
ANSWER_CACHE_DIR=./data/answer_cache
RESPONSE_CACHE_DB=./data/response_cache.sqlite3
# Optional local SQLite pipeline cache (off by default). Portkey simple cache on
# rewrite/answer configs is the primary layer; enable this only as a fallback when
# the gateway is unreachable (two caches can disagree — prefer one).
# ANSWER_CACHE=1
# Semantic near-duplicate cache (only when ANSWER_CACHE=1).
SEMANTIC_CACHE=0
SEMANTIC_CACHE_THRESHOLD=0.95
# Layer-2 claim-vs-chunk groundedness (eval sample / optional live LLM checks).
# SEMANTIC_GROUNDEDNESS_LLM=1
# SEMANTIC_GROUNDEDNESS_SAMPLE=5
PROMPT_CACHE=1
# Optional Langfuse export
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Quality gate thresholds (CI)
GATE_MIN_RECALL_AT_5=0.55
GATE_MIN_FAITHFULNESS=0.70

# --- FreeLLMAPI (local-only overflow; laptop-only) ---------------------------
# OpenAI-compatible free-tier proxy: http://127.0.0.1:3001
# docker compose up -d freellmapi
# ENCRYPTION_KEY: openssl rand -hex 32  (required; keep stable — decrypts stored keys)
# Do NOT set HOST_BIND=0.0.0.0 — compose binds host port to 127.0.0.1 only.
# ENCRYPTION_KEY=
# Seed Keys: python scripts/freellmapi_write_config.py  (then recreate freellmapi)
# Seeded providers (start set):
#   - anon/keyless: OVH AI Endpoints, AI Horde; LLM7 via documented "unused" token
#   - keyed (reuse project keys): Groq, Google, NVIDIA, OpenRouter
# Explicitly NEVER add Cohere (ToS forbids personal/household use per FreeLLMAPI table).
# GitHub Models + Gemini (google platform via FreeLLMAPI): eval-only per provider ToS —
#   do not route production traffic through FreeLLMAPI for those; Portkey remains primary.
# Pollinations: FreeLLMAPI no longer keyless — optional POLLINATIONS_API_KEY to include.
# POLLINATIONS_API_KEY=
# Unified bearer from dashboard (Keys header) or GET /api/settings/api-key — never hardcode.
# FREELLMAPI_UNIFIED_KEY=
# FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# Local dashboard login (created on first claim of http://127.0.0.1:3001) — not a cloud account.
# FREELLMAPI_DASHBOARD_EMAIL=
# FREELLMAPI_DASHBOARD_PASSWORD=
# Eval-only: legacy FreeLLMAPI overflow JSON (config/portkey/eval_judge_overflow.json)
# remains the sole Portkey home for FreeLLMAPI. Active RAGAS/DeepEval scoring uses
# the pinned single-model config (eval_judge_pinned.json) — see EVAL_JUDGE_* above.
