# Copy to .env for local development. Production values come from the secret manager (never a file).
APP_ENV=development                      # development | test | production (production refuses fakes/anonymous auth)

# PostgreSQL + pgvector (docker compose up -d postgres). The database is created by `make migrate`/alembic.
DATABASE_URL=postgresql+psycopg://passive_safety:change_me@localhost:5433/safety_assistant

# Immutable artifact store: file:// for development, s3://bucket[/prefix] in production (needs the s3 extra).
ARTIFACT_STORE_URI=file://./data/artifacts

# Providers. Only `fastembed` is allowed outside APP_ENV=test.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER=cross_encoder                   # cross_encoder (default; +0.09 MRR, ~1.5 s/query on CPU) | heuristic (fast) | none
RETRIEVAL_RERANK_TOP_N=12                # candidates scored by the cross-encoder (measured: 12 keeps the gain, bounds latency)

# LLM (optional). none = evidence-only mode. openai_compatible works with OpenAI, Azure-style proxies, vLLM, Ollama /v1.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DATA_CLASSES=["PUBLIC"]              # data classes this provider is cleared for (policy, not a heuristic)

# Auth. none = anonymous RegulationViewer (development only).
AUTH_MODE=none                           # none | api_key | oidc
API_KEYS={}                              # api_key mode: {"<token>": "<Role>"} e.g. {"dev-admin": "SafetyAdmin"}
OIDC_ISSUER=
OIDC_AUDIENCE=
# Untrusted uploads: malware scanning and OCR are optional adapters. In deployments point the scanner at a clamd
# service (MALWARE_SCANNER=clamav, CLAMAV_HOST/PORT); an unreachable scanner fails the job (retryable), never passes.
MALWARE_SCANNER=none                     # none | clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
OCR_PROVIDER=none                        # none | tesseract (needs the tesseract binary on PATH)
OCR_LANGUAGE=eng

# Browser sessions: HttpOnly cookie signed with SESSION_SECRET (>= 32 chars in production).
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_TTL_HOURS=12
# Password-less login as a seeded user (safety-assistant users add ...). Production refuses true.
DEV_LOGIN_ENABLED=true

RATE_LIMIT_PER_MINUTE=60
FETCH_ALLOWED_HOSTS=["unece.org","www.unece.org"]
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # enables trace export
