# Copy to .env for local development. Production values come from the secret manager (never a file).
APP_ENV=development                      # development | test | production (production refuses fakes/anonymous auth)

# PostgreSQL + pgvector (docker compose up -d postgres). The database is created by `make migrate`/alembic.
DATABASE_URL=postgresql+psycopg://passive_safety:change_me@localhost:5433/safety_assistant

# Immutable artifact store: file:// for development, s3://bucket[/prefix] in production (needs the s3 extra).
ARTIFACT_STORE_URI=file://./data/artifacts

# Providers. Only `fastembed` is allowed outside APP_ENV=test.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER=cross_encoder                   # cross_encoder (default; +0.09 MRR, ~1.5 s/query on CPU) | heuristic (fast) | none
RETRIEVAL_RERANK_TOP_N=12                # candidates scored by the cross-encoder (measured: 12 keeps the gain, bounds latency)
# Summary-augmented chunking (ADR-0030, README "Measured results"). Build the index first
# (`safety-assistant reindex`; SAC_ENABLED=true keeps it current for new ingests), check `safety-assistant ready`,
# then switch the query side. sac_v2 (compact) is the measured recommendation; sac_v1 (full) is experimental.
SAC_ENABLED=true
RETRIEVAL_REPRESENTATION=sac_v2          # content (baseline) | sac_v2 | sac_v1
RETRIEVAL_RERANK_WITH_CONTEXT=true       # cross-encoder sees the document line with the chunk (measured: citation hit 0.86 -> 0.90)
SUMMARY_MODEL=                           # plain instruct model for document summaries; empty = LLM_MODEL
# LLM_MODEL: a small instruct model is enough for grounded synthesis (gpt-oss-20b measured, README "Model choice").
# LLM_FALLBACK_MODEL: one retry on this model when the primary fails or returns malformed JSON (empty = off).
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=                   # empty = same gateway; e.g. https://openrouter.ai/api/v1 for a second provider
LLM_FALLBACK_API_KEY=
LLM_REASONING_EFFORT=                    # low | medium | high for routes that think before answering; empty = not sent

# LLM (optional). none = evidence-only mode. openai_compatible works with OpenAI, Azure-style proxies, vLLM, Ollama /v1.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DATA_CLASSES=["PUBLIC"]              # data classes this provider is cleared for (policy, not a heuristic)

# Auth. none = anonymous RegulationViewer (development only).
AUTH_MODE=none                           # none | api_key | oidc
API_KEYS={}                              # api_key mode: {"<token>": "<Role>"} e.g. {"dev-admin": "SafetyAdmin"}
# OIDC — bearer tokens (AUTH_MODE=oidc) and the browser sign-in flow (authorization code + PKCE).
OIDC_ISSUER=                             # e.g. https://login.microsoftonline.com/<tenant>/v2.0 or https://idp/realms/x
OIDC_AUDIENCE=                           # expected aud of API bearer tokens; defaults to OIDC_CLIENT_ID
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=                      # leave empty for a public client (PKCE only)
OIDC_REDIRECT_URI=                       # https://<app-host>/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_ROLE=                       # engineer|knowledge_admin|auditor|org_admin — role granted on first sign-in; empty = admin adds membership
FRONTEND_URL=http://localhost:3010       # post-login redirect base
# Untrusted uploads: malware scanning and OCR are optional adapters. In deployments point the scanner at a clamd
# service (MALWARE_SCANNER=clamav, CLAMAV_HOST/PORT); an unreachable scanner fails the job (retryable), never passes.
MALWARE_SCANNER=none                     # none | clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
OCR_PROVIDER=none                        # none | tesseract (needs the tesseract binary on PATH)
OCR_LANGUAGE=eng

# Browser sessions: HttpOnly cookie signed with SESSION_SECRET (>= 32 chars in production).
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_TTL_HOURS=12
# Password-less login as a seeded user (safety-assistant users add ...). Production refuses true.
DEV_LOGIN_ENABLED=true
# Self-service email/password sign-up and sign-in for passive-safety engineers (scrypt-hashed,
# never stored or logged in the clear). Independent of AUTH_MODE — this is the browser-session
# path and works in production. Per-account lockout after LOGIN_MAX_ATTEMPTS is persisted on the
# user row (survives across replicas without a shared cache) and clears on the next success.
PASSWORD_AUTH_ENABLED=true
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

RATE_LIMIT_PER_MINUTE=60
FETCH_ALLOWED_HOSTS=["unece.org","www.unece.org"]
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # enables trace export
