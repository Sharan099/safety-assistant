# --- Python / uv ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node / Next.js (frontend/) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/test-results/
frontend/playwright-report/
frontend/.env.local

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Corpus: licensed source PDFs never enter git; only the registry (hashes) is versioned ---
knowledge/**/*.pdf

# --- Content-addressed artifact store (development filesystem backend) and test artifacts ---
data/artifacts/
data/artifacts-test/

# --- Terraform ---
infra/terraform/.terraform/
infra/terraform/*.tfstate*
infra/terraform/envs/*.tfvars
!infra/terraform/envs/*.tfvars.example

# --- Logs / OS / IDE ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- evaluation caches (LLM outputs; regenerable) ---
evals/cache/

# --- generated by `next dev` (agent guidance files) ---
frontend/AGENTS.md
frontend/CLAUDE.md
.playwright-mcp/
