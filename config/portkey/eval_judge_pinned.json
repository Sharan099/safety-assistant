{

  "strategy": {

    "mode": "fallback",

    "on_status_codes": [404, 408, 413, 429, 500, 502, 503, 504]

  },

  "request_timeout": 30000,

  "targets": [

    {

      "provider": "google",

      "api_key": "${GOOGLE_API_KEY}",

      "request_timeout": 30000,

      "override_params": {

        "model": "gemini-2.5-flash",

        "thinking": { "type": "disabled", "budget_tokens": 0 }

      }

    }

  ]

}

